# Somente no servidor. Nunca colocar esses valores no HTML ou no GitHub.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Gerar no seu computador com npm run admin:setup. Nunca usar a senha em texto aqui.
ADMIN_PASSWORD_HASH=
# Na integração nativa Vercel/Upstash, KV_REST_API_URL e KV_REST_API_TOKEN
# são injetadas automaticamente e também são aceitas pelo servidor.
